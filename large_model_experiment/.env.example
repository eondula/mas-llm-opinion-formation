# Copy to .env (already created) and fill in your keys. .env is gitignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models (defaults shown). C = Claude agent, O = OpenAI agent.
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-6-astra

# Decoding. Current Claude models accept no temperature; effort sets how much hidden reasoning they do.
# low keeps hidden reasoning small, closest to the local models, which had none.
CLAUDE_EFFORT=low
# OpenAI: reasoning_effort=none and temperature=0 are sent; a model that rejects either is retried without it,
# and the dropped parameter is recorded in environment.json.
OPENAI_REASONING_EFFORT=none
OPENAI_TEMPERATURE=0

# Per-response output cap (includes any hidden reasoning tokens).
MAX_OUTPUT_TOKENS=4096
